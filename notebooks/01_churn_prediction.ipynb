   "source": [
    "## 7. Evaluation & Model Comparison\n",
    "\n",
    "We evaluate every model on the **untouched, imbalanced test set** using\n",
    "accuracy, precision, recall, F1, and ROC-AUC — precision/recall/F1 matter\n",
    "more than raw accuracy here, since we especially care about correctly\n",
    "catching customers who *will* churn (the minority class)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ade725e2",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-01T05:33:17.026350Z",
     "iopub.status.busy": "2026-08-01T05:33:17.025537Z",
     "iopub.status.idle": "2026-08-01T05:33:17.180081Z",
     "shell.execute_reply": "2026-08-01T05:33:17.178761Z"
    }
   },
   "outputs": [],
   "source": [
    "results_table = []\n",
    "\n",
    "for name, model in fitted_models.items():\n",
    "    y_pred = model.predict(X_test)\n",
    "    y_proba = model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "    acc = accuracy_score(y_test, y_pred)\n",
    "    prec = precision_score(y_test, y_pred)\n",
    "    rec = recall_score(y_test, y_pred)\n",
    "    f1 = f1_score(y_test, y_pred)\n",
    "    auc = roc_auc_score(y_test, y_proba)\n",
    "\n",
    "    results_table.append({\n",
    "        \"Model\": name,\n",
    "        \"Accuracy\": acc,\n",
    "        \"Precision\": precision_score(y_test, y_pred),\n",
    "        \"Recall\": rec,\n",
    "        \"F1\": f1,\n",
    "        \"ROC-AUC\": auc,\n",
    "        \"CV Accuracy (mean)\": cv_results[name].mean(),\n",
    "    })\n",
    "\n",
    "    print(f\"\\n=== {name} ===\")\n",
    "    print(confusion_matrix(y_test, y_pred))\n",
    "    print(classification_report(y_test, y_pred, target_names=[\"No Churn\", \"Churn\"]))\n",
    "\n",
    "results_df = pd.DataFrame(results_table).set_index(\"Model\").sort_values(\"F1\", ascending=False)\n",
    "results_df\n"
   ]
  },
