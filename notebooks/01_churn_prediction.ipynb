    "## 10. Quick Sanity Check — Reload & Predict on a Sample Input\n",
    "\n",
    "This mirrors exactly what `app/streamlit_app.py` will do: load the\n",
    "bundle, encode a raw input row with the saved encoders (in the saved\n",
    "column order), and get a prediction + probability."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "61f9ebb5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-01T05:33:18.171762Z",
     "iopub.status.busy": "2026-08-01T05:33:18.171577Z",
     "iopub.status.idle": "2026-08-01T05:33:18.193101Z",
     "shell.execute_reply": "2026-08-01T05:33:18.191811Z"
    }
   },
   "outputs": [],
   "source": [
    "# Reload the saved bundle fresh, as the Streamlit app would\n",
    "loaded = joblib.load(MODEL_PATH)\n",
    "\n",
    "loaded_model = loaded[\"model\"]\n",
    "loaded_encoders = loaded[\"encoders\"]\n",
    "loaded_feature_names = loaded[\"feature_names\"]\n",
    "\n",
    "# Example raw customer record (same shape/keys as the original columns,\n",
    "# minus customerID and Churn)\n",
    "sample_input = {\n",
    "    \"gender\": \"Female\",\n",
    "    \"SeniorCitizen\": 0,\n",
    "    \"Partner\": \"Yes\",\n",
    "    \"Dependents\": \"No\",\n",
    "    \"tenure\": 1,\n",
    "    \"PhoneService\": \"No\",\n",
    "    \"MultipleLines\": \"No phone service\",\n",
    "    \"InternetService\": \"DSL\",\n",
    "    \"OnlineSecurity\": \"No\",\n",
    "    \"OnlineBackup\": \"Yes\",\n",
    "    \"DeviceProtection\": \"No\",\n",
    "    \"TechSupport\": \"No\",\n",
    "    \"StreamingTV\": \"No\",\n",
    "    \"StreamingMovies\": \"No\",\n",
    "    \"Contract\": \"Month-to-month\",\n",
    "    \"PaperlessBilling\": \"Yes\",\n",
    "    \"PaymentMethod\": \"Electronic check\",\n",
    "    \"MonthlyCharges\": 29.85,\n",
    "    \"TotalCharges\": 29.85,\n",
    "}\n",
    "\n",
    "sample_df = pd.DataFrame([sample_input])\n",
    "\n",
    "# Apply the saved label encoders to the categorical columns\n",
    "for col, encoder in loaded_encoders.items():\n",
    "    sample_df[col] = encoder.transform(sample_df[col])\n",
    "\n",
    "# Make sure column order matches training exactly\n",
    "sample_df = sample_df[loaded_feature_names]\n",
    "\n",
    "prediction = loaded_model.predict(sample_df)[0]\n",
    "probability = loaded_model.predict_proba(sample_df)[0][1]\n",
    "\n",
    "print(f\"Prediction: {'Churn' if prediction == 1 else 'No Churn'}\")\n",
    "print(f\"Churn probability: {probability:.2%}\")\n"
   ]
